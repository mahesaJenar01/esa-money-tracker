<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Compose owns the real styling; this theme only controls the window
        background and the splash colour before the first frame is drawn.
    -->
    <style name="Theme.MoneyTracker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
