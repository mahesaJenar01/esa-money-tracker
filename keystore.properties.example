# Copy this file to `keystore.properties` and fill it in.
#
# `keystore.properties` and the key itself are never committed and never leave
# this PC. Without them the release build still runs, it just comes out
# unsigned and no phone will install it.
#
# The key is the single thing that decides whether a new APK counts as an
# *update* to the app already on your phone or as a stranger with the same
# name. Lose it and the only way back is uninstalling, which takes your
# recorded transactions with it. Back the file up somewhere you will still have
# it in five years.
#
# `run.bat keystore` creates a key and prints exactly what to put here.

# Absolute path, or relative to the project folder. Forward slashes.
storeFile=C:/Users/<you>/keys/esa-money-tracker.jks
storePassword=<the keystore password you chose>
keyAlias=esa-money-tracker
keyPassword=<the key password you chose>
